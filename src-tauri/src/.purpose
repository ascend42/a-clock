version: 1.0.0
description: Rust entry point and native plugin registration
components:
  tauri-core:
    description: 'Tauri entry point. Registers opener/dialog/notification plugins; enables the asset protocol (incl. app-data dir). Desktop-only tray + hide-on-close (main window). Commands: open_video (desktop looping YouTube window) and import_media (copies a picked file into the app''s data dir so it''s durable and playable in-app, esp. on iOS).'
    type: core
    file: src-tauri/src/lib.rs
