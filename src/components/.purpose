version: 1.0.0
description: React view components for the clock, alarm, stopwatch, timer, and pomodoro surfaces
context:
  - Presentational + interactive components. Alarm/clock state is owned by App.tsx and passed down via props.
components:
  clock-view:
    description: 'Clock display surface: analog face or digital/numerical readout with 24-hour and seconds toggles.'
    type: view
    flows:
      - $clock-display
    components:
      - '#analog-clock'
    file: src/components/ClockView.tsx
  analog-clock:
    description: SVG analog clock face with hour/minute/second hands and tick marks.
    type: view
    parent: '#clock-view'
    file: src/components/AnalogClock.tsx
  alarms-view:
    description: Lists alarms; create, edit, enable/disable, delete, duplicate, and test each one. Header toggle arms macOS wake-from-sleep for alarms.
    type: view
    flows:
      - $alarm-lifecycle
      - $trigger-preview
    components:
      - '#alarm-editor'
    file: src/components/AlarmsView.tsx
  alarm-editor:
    description: 'Create/edit an alarm: time, label, repeat days, snooze toggle, trigger (beep/YouTube/file), and an optional solve-to-dismiss puzzle. Provides inline testing for both the sound and the puzzle problems before saving.'
    type: view
    parent: '#alarms-view'
    flows:
      - $trigger-preview
    components:
      - '#trigger-player'
      - '#filepick'
      - '#youtube'
      - '#puzzle-gate'
    file: src/components/AlarmEditor.tsx
  ringing-overlay:
    description: Full-screen alarm ringing surface; plays the trigger on loop with Dismiss and (when enabled) Snooze. When the alarm has a puzzle, Dismiss opens the solve-to-dismiss gate and the sound pauses until solved or timed out.
    type: view
    flows:
      - $alarm-lifecycle
    signals:
      - '!alarm-snoozed'
      - '!alarm-dismissed'
    components:
      - '#trigger-player'
      - '#puzzle-gate'
    file: src/components/RingingOverlay.tsx
  trigger-player:
    description: 'Renders and loops the active trigger: a WebAudio beep, an embedded looping YouTube video, or a local audio/video element served via the Tauri asset protocol.'
    type: view
    components:
      - '#beep'
      - '#youtube'
    file: src/components/TriggerPlayer.tsx
  puzzle-gate:
    description: 'Solve-to-dismiss overlay: N math problems with a countdown; solving all correctly dismisses the alarm, a wrong answer buzzes and regenerates them, and running out of time resumes the ringing.'
    type: view
    parent: '#ringing-overlay'
    components:
      - '#puzzle'
      - '#beep'
    file: src/components/PuzzleGate.tsx
  stopwatch:
    description: 'Stopwatch tab: start/stop/resume/reset with centisecond precision and lap splits. Uses performance.now() so it stays accurate across background throttling.'
    type: view
    file: src/components/StopwatchView.tsx
  timer:
    description: 'Countdown timer tab: preset or custom mm:ss duration, start/pause/reset; on completion it beeps until dismissed and posts a notification.'
    type: view
    components:
      - '#beep'
      - '#format'
      - '#native'
    file: src/components/TimerView.tsx
  pomodoro:
    description: 'Pomodoro tab: focus/short-break/long-break cycles with a progress ring, editable durations, auto-start, chime + notification on each phase change, and a completed-session count. Settings persist via #storage.'
    type: view
    components:
      - '#beep'
      - '#format'
      - '#native'
      - '#storage'
    file: src/components/PomodoroView.tsx
