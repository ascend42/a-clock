version: 1.0.0
description: Persistence, audio, YouTube parsing, and native file-picking utilities
components:
  storage:
    description: Loads and saves alarms, clock settings, and pomodoro settings to localStorage; fails safe when storage is unavailable.
    type: lib
    file: src/lib/storage.ts
  beep:
    description: 'WebAudio looping beeper plus an audio-unlock helper: resuming the AudioContext on a user gesture so an alarm hours later can still make sound.'
    type: lib
    file: src/lib/beep.ts
  youtube:
    description: Parses YouTube video IDs from many URL shapes (watch, youtu.be, embed, shorts, live, bare id) and builds a looping autoplay embed URL.
    type: lib
    file: src/lib/youtube.ts
  filepick:
    description: Opens the native Tauri file dialog for an audio/video file and classifies it as audio or video by extension.
    type: lib
    file: src/lib/filepick.ts
  native:
    description: 'Native OS integration: request notification permission, post a macOS notification when an alarm fires, and surface (show/unminimize/focus) the window when it is hidden in the tray.'
    type: lib
    signals:
      - '!alarm-fired'
    file: src/lib/native.ts
  alarm-utils:
    description: 'Alarm helpers: nextFreeSlot rounds a time up to the next free 15-minute grid slot (skipping times already used), and duplicateAlarm clones an alarm into that slot with a fresh id.'
    type: lib
    flows:
      - $alarm-lifecycle
    file: src/lib/alarm.ts
  puzzle:
    description: Generates simple math problems by difficulty (easy add/subtract, medium multiply/larger sums, hard multiply-and-add) for the solve-to-dismiss gate.
    type: lib
    file: src/lib/puzzle.ts
  format:
    description: Formats a millisecond duration as a clock string (hours only when needed, optional centiseconds) for the stopwatch, timer, and pomodoro.
    type: lib
    file: src/lib/format.ts
  mobile-alarms:
    description: On iOS/Android, schedules each enabled alarm as an OS local notification (Schedule.at for one-time, weekly Schedule.interval per repeat day) so alarms fire when backgrounded/locked. No-op on desktop. Detects mobile via userAgent and computes each alarm's next occurrence.
    type: lib
    flows:
      - $alarm-lifecycle
    components:
      - '#native'
    file: src/lib/mobileAlarms.ts
  wakelock:
    description: 'Nightstand mode: requests a screen Wake Lock so the phone doesn''t auto-lock and freeze the in-app alarm scheduler; re-acquires on visibility change. No-op where the Wake Lock API is unavailable.'
    file: src/lib/wakelock.ts
    type: lib
